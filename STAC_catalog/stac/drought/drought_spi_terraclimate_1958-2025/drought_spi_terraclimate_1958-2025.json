  "properties": {
    "title": "Meteorological Drought (Standardized Precipitation Index)",
    "description": "SPI measures the deviation of precipitation from the climatological average over a given accumulation period and is widely used to detect and characterize meteorological droughts. Probability values are computed from the full 1958–2025 record (804 monthly time steps) dividing the numbers of months lower than TH (1.5) with total months",
    "GCHD:hazard": "Droughts",
    "GCHD:hazard_phase": "Preparedness/Planning",
    "GCHD:data_type": "Probabilistic - empirical",
    "GCHD:nominal_resolution": "5km",
    "GCHD:coverage": "Global",
    "GCHD:units": "Index",
    "GCHD:threshold": ">0.09 (global mean)",
    "GCHD:classes": "Use natural breaks/quantile",
    "GCHD:value_range": [
      -10.0,
      10.0
    ],
    "GCHD:notes": "The SPI measures the precipitation deficit that accumulated over the preceding months and evaluates the deficit with respect to a reference period -12-month time scale. More details: https://github.com/dohyung-kim/precip-index/blob/main/README.md",
    "GCHD:alternate_sources": "World Bank (GOST)",
