  "properties": {
    "title": "Riverine flood hazard – tile N30 E80",
    "description": "A fluvial or riverine flood is a rise, usually brief, in the water level of a stream or water body to a peak from which the water level recedes at a slower rate.",
    "GCHD:hazard": "Floods",
    "GCHD:hazard_phase": "Preparedness/Planning",
    "GCHD:data_type": "Probabilistic - 100 year return period",
    "GCHD:nominal_resolution": "90m",
