# Copy to STAC_catalog/.env (git-ignored) and fill in.
# Storage account: unidatadapmclimatechange
#   Azure portal > Storage account > Security + networking > Access keys > Connection string
AZURE_STORAGE_CONNECTION_STRING=

# Private container holding the raw river flood tiles (CCRI/data/raw/riverline_flood/2025_update/)
RAW_CONTAINER=climate
# Public container where COGs are written (anonymous read)
PUBLIC_CONTAINER=public
COG_PREFIX=gchd_cog
